# Copy to .env.local — never commit real values.
NEXT_PUBLIC_SITE_URL=https://www.sequelcloset.pk

# --- Supabase (when you connect the real backend) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by the admin panel / webhooks only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (server-side only) ---
# "off" hides Online Payment, "demo" uses the built-in simulated gateway.
NEXT_PUBLIC_ONLINE_PAYMENTS=demo
PAYMENT_GATEWAY_SECRET=
