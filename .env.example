# Copy to .env.local for local dev — never commit real values.
# In production (Vercel), set these under Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://beyondwear.store

# --- Email notifications (free — Gmail SMTP) ---
# See src/lib/mailer.ts for the 5-minute setup (Gmail App Password, no paid service).
# Powers /api/contact, /api/newsletter, and the order-placed email in lib/adapters/orders.ts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=

# --- Analytics (free — optional) ---
# Your Google Analytics 4 Measurement ID (starts with "G-"). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# --- Supabase (when you connect the real backend) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_. Used by the admin panel / webhooks only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (server-side only) ---
# "off" (default) hides Online Payment entirely — real customers only see COD
# and Bank Transfer, which actually work. "demo" shows a simulated gateway —
# use that only while YOU are testing the checkout flow, never for real customers.
NEXT_PUBLIC_ONLINE_PAYMENTS=off
PAYMENT_GATEWAY_SECRET=
